# ---------------------------------------------------------------------------
# Variables de entorno de la demo "Banolia"
# Copie este archivo a .env y rellene los valores. NUNCA suba .env al repositorio.
# En Vercel se definen en: Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# Clave para firmar la cookie de sesion (HMAC-SHA256).
# Genere una larga y aleatoria, por ejemplo con:  openssl rand -hex 32
SESSION_SECRET=

# Token de GitHub *fine-grained* con permiso "Contents: Read & Write"
# limitado UNICAMENTE a este repositorio.
#
# IMPORTANTE: debe pertenecer a la MISMA cuenta de GitHub que ejecuta la rutina.
# Si los commits de la web quedan atribuidos a otra identidad, la rutina perdera
# la capacidad de publicar en `main` (Claude Code rechaza el push a una rama que
# contiene commits de otra persona).
GITHUB_TOKEN=

# Repositorio destino en formato usuario/repositorio
GITHUB_REPO=CarlosJavierRodriguezChamizo/banolia

# Rama sobre la que escribe la web
GITHUB_BRANCH=main

# Disparador API de la rutina de Claude Code.
# Se obtienen en https://claude.ai/code/routines al anadir un trigger de tipo "API".
# OJO: el token se muestra UNA SOLA VEZ, copielo en ese momento.
ROUTINE_FIRE_URL=https://api.anthropic.com/v1/claude_code/routines/trig_XXXXXXXXXXXX/fire
ROUTINE_FIRE_TOKEN=
