---
/**
 * Detalle de una solicitud: el recorrido completo de los agentes.
 * En la fase 4 se añade aquí el formulario HITL para las pendientes de humano.
 */
import Base from '../../layouts/Base.astro';
import Insignia from '../../components/Insignia.astro';
import {
  solicitudPorId, respuestasDelBuild, indexarRespuestas, estadoEfectivo,
  reglaPorId, criterioPorCodigo, productoPorSku, clientePorId,
} from '../../lib/datos.ts';
import {
  ETIQUETA_CATEGORIA, ETIQUETA_PRIORIDAD, ETIQUETA_ESTADO, ETIQUETA_CANAL,
  ETIQUETA_AGENTE, etiquetaSentimiento, pesos, fechaHora, fechaCorta,
  formatearCalculo, etiquetaCalculo,
} from '../../lib/formato.ts';

export const prerender = false;

const { id } = Astro.params;
const solicitud = id ? solicitudPorId.get(id) : undefined;

if (!solicitud) {
  return new Response('Solicitud no encontrada', { status: 404 });
}

const respuestas = indexarRespuestas(respuestasDelBuild);
const estado = estadoEfectivo(solicitud, respuestas);
const respuestaHumana = respuestas.get(solicitud.id);
const clienteCompleto = clientePorId.get(solicitud.cliente.id);

const TONO_ESTADO: Record<string, 'ia' | 'humano' | 'respondido' | 'descartado'> = {
  resuelto_ia: 'ia',
  pendiente_humano: 'humano',
  respondido_humano: 'respondido',
  descartado: 'descartado',
};

// `_referencia` no se pasa a la plantilla: se mostrará solo a administradores
// en la fase 4, cuando exista sesión.
const { _referencia, ...s } = solicitud;

const calculos = Object.entries(s.analisisPolitica.calculos);
---

<Base titulo={`Solicitud ${s.id}`} descripcion={s.asunto}>
  <nav aria-label="Ruta de navegación" class="mb-4 text-sm">
    <a href="/" class="text-marca hover:underline">Tablero</a>
    <span class="mx-1.5 text-slate-400">/</span>
    <span class="font-mono text-slate-600">{s.id}</span>
  </nav>

  <header class="mb-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div class="min-w-0">
        <h1 class="text-xl font-bold tracking-tight text-slate-900">{s.asunto}</h1>
        <p class="mt-1 text-sm text-slate-600">
          Recibida el {fechaHora(s.recibidaEn)} · {ETIQUETA_CANAL[s.canal]} · lote
          <span class="font-mono">{s.loteId}</span>
        </p>
      </div>
      <Insignia texto={ETIQUETA_ESTADO[estado]} tono={TONO_ESTADO[estado]} />
    </div>

    <div class="mt-3 flex flex-wrap gap-1.5">
      <Insignia texto={ETIQUETA_CATEGORIA[s.clasificacion.categoria]} tono="marca" />
      <Insignia texto={s.clasificacion.subcategoria} tono="neutro" />
      <Insignia texto={`Prioridad ${ETIQUETA_PRIORIDAD[s.clasificacion.prioridad]}`} tono={s.clasificacion.prioridad} />
      <Insignia texto={`SLA ${s.decision.slaHoras} h`} tono="neutro" />
    </div>
  </header>

  <div class="grid min-w-0 gap-6 lg:grid-cols-3">
    <!-- Columna principal -->
    <div class="min-w-0 space-y-6 lg:col-span-2">

      <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">Mensaje del cliente</h2>
        <p class="whitespace-pre-line break-words text-sm leading-relaxed text-slate-800">{s.mensaje}</p>

        {s.adjuntos.length > 0 && (
          <div class="mt-4 border-t border-slate-100 pt-3">
            <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Adjuntos</h3>
            <ul class="mt-2 space-y-1">
              {s.adjuntos.map((a) => (
                <li class="flex gap-2 text-sm text-slate-700">
                  <Insignia texto={a.tipo} tono="neutro" />
                  <span>{a.descripcion}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>

      <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="mb-1 text-sm font-semibold uppercase tracking-wide text-slate-500">
          Análisis de política
        </h2>
        <p class="mb-4 text-sm text-slate-600">
          {s.analisisPolitica.cumple === true && 'El caso cumple la política aplicable.'}
          {s.analisisPolitica.cumple === false && 'El caso NO cumple la política aplicable.'}
          {s.analisisPolitica.cumple === null && 'No hay reglas de política aplicables.'}
        </p>

        {s.analisisPolitica.reglasAplicables.length > 0 && (
          <ul class="space-y-2">
            {s.analisisPolitica.reglasAplicables.map((idRegla) => {
              const regla = reglaPorId.get(idRegla);
              return (
                <li>
                  <details class="group rounded-lg border border-slate-200 bg-slate-50/60">
                    <summary class="cursor-pointer list-none px-3 py-2 text-sm font-medium text-slate-800 hover:bg-slate-100">
                      <span class="font-mono text-marca">{idRegla}</span>
                      <span class="ml-2">{regla?.titulo ?? 'Regla desconocida'}</span>
                      {regla && (
                        <span class="ml-2 text-xs font-normal text-slate-500">
                          ({regla.fuente === 'original-adaptada' ? 'adaptada' : 'inventada'})
                        </span>
                      )}
                    </summary>
                    <p class="border-t border-slate-200 px-3 py-2 text-sm leading-relaxed text-slate-700">
                      {regla?.texto ?? 'Esta regla no existe en politica.json.'}
                    </p>
                  </details>
                </li>
              );
            })}
          </ul>
        )}

        {calculos.length > 0 && (
          <div class="mt-4">
            <h3 class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">Cálculos</h3>
            <dl class="grid gap-x-4 gap-y-1 text-sm sm:grid-cols-2">
              {calculos.map(([clave, valor]) => {
                const lineas = formatearCalculo(clave, valor);
                return (
                  <div class="min-w-0 border-b border-slate-100 py-1">
                    <dt class="text-xs text-slate-500">{etiquetaCalculo(clave)}</dt>
                    <dd class="break-words font-medium text-slate-900">
                      {lineas.length === 1 ? lineas[0] : (
                        <ul class="mt-0.5 space-y-0.5">
                          {lineas.map((l) => <li class="text-xs font-normal text-slate-700">{l}</li>)}
                        </ul>
                      )}
                    </dd>
                  </div>
                );
              })}
            </dl>
          </div>
        )}

        {s.analisisPolitica.riesgos.length > 0 && (
          <div class="mt-4 rounded-lg bg-amber-50 p-3 ring-1 ring-amber-200">
            <h3 class="text-xs font-semibold uppercase tracking-wide text-amber-800">Riesgos detectados</h3>
            <ul class="mt-1.5 list-disc space-y-1 pl-5 text-sm text-amber-900">
              {s.analisisPolitica.riesgos.map((r) => <li>{r}</li>)}
            </ul>
          </div>
        )}
      </section>

      <!-- Línea de tiempo de los agentes -->
      <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-500">
          Recorrido de los agentes
        </h2>
        <ol class="relative space-y-4 border-l-2 border-slate-200 pl-5">
          {s.traza.map((paso) => (
            <li class="relative">
              <span
                class="absolute -left-[27px] grid h-5 w-5 place-items-center rounded-full bg-marca text-[10px] font-bold text-white"
                aria-hidden="true">{paso.orden}</span>

              <div class="flex flex-wrap items-center gap-2">
                <h3 class="text-sm font-semibold text-slate-900">{ETIQUETA_AGENTE[paso.agente] ?? paso.agente}</h3>
                <span class="text-xs text-slate-500">{paso.accion}</span>
                {paso.confianza !== null && (
                  <Insignia texto={`confianza ${paso.confianza.toFixed(2)}`} tono="neutro" />
                )}
              </div>

              <p class="mt-0.5 text-sm font-medium text-slate-700">{paso.resultado}</p>
              <p class="mt-1 text-sm leading-relaxed text-slate-600">{paso.justificacion}</p>

              {(paso.reglas.length > 0 || paso.criterios.length > 0) && (
                <div class="mt-1.5 flex flex-wrap gap-1">
                  {paso.reglas.map((r) => <Insignia texto={r} tono="marca" titulo={reglaPorId.get(r)?.titulo} />)}
                  {paso.criterios.map((c) => (
                    <Insignia texto={c} tono="humano" titulo={criterioPorCodigo.get(c)?.nombre} />
                  ))}
                </div>
              )}
            </li>
          ))}
        </ol>
      </section>

      {s.borrador && (
        <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">
              {estado === 'pendiente_humano' ? 'Borrador sugerido' : 'Borrador de la IA'}
            </h2>
            <div class="flex gap-1.5">
              <Insignia texto={ETIQUETA_AGENTE[s.borrador.redactadoPor]} tono="marca" />
              <Insignia texto={`${s.borrador.iteraciones} iteración${s.borrador.iteraciones > 1 ? 'es' : ''}`} tono="neutro" />
            </div>
          </div>
          <p class="whitespace-pre-line break-words rounded-lg bg-slate-50 p-4 text-sm leading-relaxed text-slate-800">
            {s.borrador.texto}
          </p>

          {s.revision && s.revision.observaciones.length > 0 && (
            <div class="mt-3 rounded-lg bg-sky-50 p-3 ring-1 ring-sky-200">
              <h3 class="text-xs font-semibold uppercase tracking-wide text-sky-800">
                Observaciones del supervisor de calidad
              </h3>
              <ul class="mt-1.5 list-disc space-y-1 pl-5 text-sm text-sky-900">
                {s.revision.observaciones.map((o) => <li>{o}</li>)}
              </ul>
            </div>
          )}
        </section>
      )}

      {s.respuestaFinal && (
        <section class="rounded-xl border-2 border-emerald-200 bg-emerald-50/50 p-5 shadow-sm">
          <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-emerald-800">
            Respuesta enviada al cliente
            <span class="ml-2 font-normal normal-case text-emerald-700">
              ({s.respuestaFinal.autor === 'ia' ? 'redactada por la IA' : 'redactada por una persona'})
            </span>
          </h2>
          <p class="whitespace-pre-line break-words rounded-lg bg-white p-4 text-sm leading-relaxed text-slate-800">
            {s.respuestaFinal.texto}
          </p>
        </section>
      )}

      {estado === 'pendiente_humano' && (
        <p class="rounded-xl border border-dashed border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
          Esta solicitud está pendiente de respuesta humana. El formulario para responderla
          se habilita en la fase 4, al añadir el inicio de sesión.
        </p>
      )}
    </div>

    <!-- Columna lateral -->
    <aside class="min-w-0 space-y-6">
      <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">Cliente</h2>
        <dl class="space-y-1.5 text-sm">
          <div class="flex justify-between gap-2">
            <dt class="text-slate-600">Nombre</dt>
            <dd class="text-right font-medium text-slate-900">{s.cliente.nombre}</dd>
          </div>
          <div class="flex justify-between gap-2">
            <dt class="text-slate-600">Identificador</dt>
            <dd class="font-mono text-slate-900">{s.cliente.id}</dd>
          </div>
          <div class="flex justify-between gap-2">
            <dt class="text-slate-600">Ciudad</dt>
            <dd class="text-right text-slate-900">{s.cliente.ciudad} (zona {s.cliente.zona})</dd>
          </div>
          <div class="flex justify-between gap-2">
            <dt class="text-slate-600">Tipo</dt>
            <dd class="text-slate-900">{s.cliente.tipo === 'profesional' ? 'Profesional' : 'Particular'}</dd>
          </div>
          {clienteCompleto && (
            <>
              <div class="flex justify-between gap-2">
                <dt class="text-slate-600">Pedidos previos</dt>
                <dd class="text-slate-900">{clienteCompleto.pedidosPrevios}</dd>
              </div>
              <div class="flex justify-between gap-2">
                <dt class="text-slate-600">Valor histórico</dt>
                <dd class="text-right font-medium text-slate-900">{pesos(clienteCompleto.valorHistoricoCOP)}</dd>
              </div>
            </>
          )}
        </dl>
      </section>

      {s.pedido && (
        <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">Pedido</h2>
          <dl class="space-y-1.5 text-sm">
            <div class="flex justify-between gap-2">
              <dt class="text-slate-600">Número</dt>
              <dd class="font-mono text-slate-900">{s.pedido.numero}</dd>
            </div>
            <div class="flex justify-between gap-2">
              <dt class="text-slate-600">Fecha</dt>
              <dd class="text-slate-900">{fechaCorta(s.pedido.fecha)}</dd>
            </div>
            <div class="flex justify-between gap-2">
              <dt class="text-slate-600">Estado</dt>
              <dd class="text-slate-900">{s.pedido.estado}</dd>
            </div>
            {s.pedido.fechaEntrega && (
              <div class="flex justify-between gap-2">
                <dt class="text-slate-600">Entregado</dt>
                <dd class="text-slate-900">{fechaCorta(s.pedido.fechaEntrega)}</dd>
              </div>
            )}
          </dl>

          <ul class="mt-3 space-y-2 border-t border-slate-100 pt-3">
            {s.pedido.lineas.map((linea) => {
              const producto = productoPorSku.get(linea.sku);
              return (
                <li class="text-sm">
                  <p class="font-medium leading-snug text-slate-900">{producto?.nombre ?? linea.sku}</p>
                  <p class="text-xs text-slate-500">
                    <span class="font-mono">{linea.sku}</span> · {linea.cantidad} × {pesos(linea.precioCOP)}
                    {producto?.aMedida && ' · a medida'}
                  </p>
                </li>
              );
            })}
          </ul>

          <p class="mt-3 flex justify-between border-t border-slate-100 pt-2 text-sm font-semibold">
            <span class="text-slate-700">Total</span>
            <span class="text-slate-900">{pesos(s.pedido.totalCOP)}</span>
          </p>
        </section>
      )}

      <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">Clasificación</h2>
        <dl class="space-y-1.5 text-sm">
          <div class="flex justify-between gap-2">
            <dt class="text-slate-600">Confianza</dt>
            <dd class="font-medium text-slate-900">{s.clasificacion.confianza.toFixed(2)}</dd>
          </div>
          <div class="flex justify-between gap-2">
            <dt class="text-slate-600">Sentimiento</dt>
            <dd class="text-right text-slate-900">
              {etiquetaSentimiento(s.clasificacion.sentimiento)} ({s.clasificacion.sentimiento > 0 ? '+' : ''}{s.clasificacion.sentimiento})
            </dd>
          </div>
        </dl>
      </section>

      {s.decision.criterios.length > 0 && (
        <section class="rounded-xl border border-amber-200 bg-amber-50/60 p-5 shadow-sm">
          <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-amber-800">
            {s.decision.ruta === 'descartado' ? 'Motivo del descarte' : 'Por qué escaló a una persona'}
          </h2>
          <ul class="space-y-2">
            {s.decision.criterios.map((codigo) => {
              const criterio = criterioPorCodigo.get(codigo);
              return (
                <li class="text-sm">
                  <p class="font-medium text-amber-900">
                    <span class="font-mono">{codigo}</span> · {criterio?.nombre}
                  </p>
                  <p class="text-amber-800">{criterio?.descripcion}</p>
                </li>
              );
            })}
          </ul>
        </section>
      )}

      {s.decision.fichaEscalado && (
        <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500">Ficha de escalado</h2>
          <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-500">Qué debe decidir</h3>
          <p class="mt-1 text-sm text-slate-800">{s.decision.fichaEscalado.queDecidir}</p>

          <h3 class="mt-3 text-xs font-semibold uppercase tracking-wide text-slate-500">Opciones</h3>
          <ul class="mt-1 list-decimal space-y-1 pl-5 text-sm text-slate-700">
            {s.decision.fichaEscalado.opciones.map((o) => <li>{o}</li>)}
          </ul>

          <h3 class="mt-3 text-xs font-semibold uppercase tracking-wide text-slate-500">Riesgos</h3>
          <ul class="mt-1 list-disc space-y-1 pl-5 text-sm text-slate-700">
            {s.decision.fichaEscalado.riesgos.map((r) => <li>{r}</li>)}
          </ul>
        </section>
      )}

      {respuestaHumana && (
        <section class="rounded-xl border border-sky-200 bg-sky-50/60 p-5 shadow-sm">
          <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-sky-800">Intervención humana</h2>
          <dl class="space-y-1.5 text-sm">
            <div class="flex justify-between gap-2">
              <dt class="text-sky-700">Usuario</dt>
              <dd class="font-medium text-sky-900">{respuestaHumana.usuario}</dd>
            </div>
            <div class="flex justify-between gap-2">
              <dt class="text-sky-700">Acción</dt>
              <dd class="text-sky-900">{respuestaHumana.accion.replace(/_/g, ' ')}</dd>
            </div>
            <div class="flex justify-between gap-2">
              <dt class="text-sky-700">Respondida</dt>
              <dd class="text-right text-sky-900">{fechaHora(respuestaHumana.respondidaEn)}</dd>
            </div>
          </dl>
        </section>
      )}
    </aside>
  </div>
</Base>
