---
import Base from '../layouts/Base.astro';
import PendienteDeFase from '../components/PendienteDeFase.astro';
export const prerender = false;
---
<Base titulo="Métricas">
  <h1 class="mb-6 text-2xl font-bold tracking-tight text-slate-900">Métricas</h1>
  <PendienteDeFase fase={5} descripcion="Volumen por día y sección, porcentaje de automatización, criterios de escalado más frecuentes, precisión del clasificador y cumplimiento de SLA." />
