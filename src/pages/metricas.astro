---
/**
 * Métricas del sistema.
 *
 * Todo se calcula a partir de los lotes y de las respuestas humanas, incluidas las
 * leídas en vivo. `data/metricas/diarias.json` sigue siendo el histórico que escribe
 * la rutina, pero la página no lo lee: así las cifras nunca se desfasan respecto de
 * los datos que se muestran en el resto de la web.
 */
import Base from '../layouts/Base.astro';
import BarrasHorizontales from '../components/BarrasHorizontales.astro';
import ColumnasApiladas from '../components/ColumnasApiladas.astro';
import { solicitudes, indexarRespuestas, criterioPorCodigo } from '../lib/datos.ts';
import { respuestasHumanas } from '../lib/vivo.ts';
import { configGithub } from '../lib/config.ts';
import { calcularMetricas, pct } from '../lib/metricas.ts';

export const prerender = false;

const { respuestas: lista } = await respuestasHumanas(configGithub());
const respuestas = indexarRespuestas(lista);

const nombresCriterio = new Map(
  [...criterioPorCodigo.entries()].map(([c, v]) => [c, `${c} · ${v.nombre}`]),
);

const m = calcularMetricas(solicitudes, respuestas, nombresCriterio);

const PRINCIPALES = [
  {
    etiqueta: 'Automatización',
    valor: pct(m.automatizacion),
    detalle: `${m.porEstado.resuelto_ia} de ${m.total - m.porEstado.descartado} solicitudes que requerían respuesta`,
  },
  {
    etiqueta: 'Precisión del clasificador',
    valor: pct(m.precision.categoria),
    detalle: `${m.precision.aciertosCategoria} de ${m.precision.evaluadas} categorías acertadas`,
  },
  {
    etiqueta: 'Borradores aprobados tal cual',
    valor: pct(m.borrador.tasaAprobacion),
    detalle: m.borrador.total > 0
      ? `${m.borrador.aprobados} de ${m.borrador.total} respuestas humanas`
      : 'Todavía nadie ha respondido desde la web',
  },
  {
    etiqueta: 'SLA cumplido',
    valor: pct(m.sla.cumplido),
    detalle: m.sla.dentro + m.sla.fuera > 0
      ? `${m.sla.dentro} de ${m.sla.dentro + m.sla.fuera} respondidas en plazo`
      : `${m.sla.pendientes} en cola, ${m.sla.pendientesVencidos} con el plazo vencido`,
  },
];

const ACCIONES_BORRADOR = [
  { clave: 'aprobar', etiqueta: 'Aprobado tal cual', n: m.borrador.aprobados },
  { clave: 'editar', etiqueta: 'Editado', n: m.borrador.editados },
  { clave: 'reescribir', etiqueta: 'Reescrito desde cero', n: m.borrador.reescritos },
  { clave: 'otros', etiqueta: 'Reclasificado o descartado', n: m.borrador.otros },
].filter((a) => m.borrador.total > 0);
---

<Base titulo="Métricas" descripcion="Cómo se está comportando el orquestador de agentes">
  <header class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-slate-900">Métricas</h1>
    <p class="mt-1 max-w-3xl text-sm text-slate-600">
      Calculadas sobre las {m.total} solicitudes publicadas hasta ahora. Incluyen las
      respuestas humanas leídas en vivo, así que reflejan el estado real aunque todavía
      no se haya vuelto a desplegar.
    </p>
  </header>

  <section aria-label="Indicadores principales" class="mb-8 grid grid-cols-2 gap-3 lg:grid-cols-4">
    {PRINCIPALES.map((k) => (
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-slate-500">{k.etiqueta}</p>
        <p class="mt-1.5 text-3xl font-bold text-marca-oscuro">{k.valor}</p>
        <p class="mt-0.5 text-xs leading-snug text-slate-500">{k.detalle}</p>
      </div>
    ))}
  </section>

  <div class="mb-6 grid min-w-0 gap-4 lg:grid-cols-2">
    <ColumnasApiladas dias={m.porDia} />

    <BarrasHorizontales
      titulo="Volumen por sección"
      descripcion="Dónde se concentra el trabajo de atención al cliente."
      filas={m.porSeccion} />
  </div>

  <div class="mb-6 grid min-w-0 gap-4 lg:grid-cols-2">
    <BarrasHorizontales
      titulo="Criterios de escalado más frecuentes"
      descripcion="Por qué motivos acaban los casos en manos de una persona. Una solicitud puede activar varios."
      filas={m.criterios}
      unidad="activaciones"
      color="#b45309" />

    <div class="min-w-0 space-y-4">
      <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h3 class="text-sm font-semibold text-slate-900">Precisión frente a la etiqueta de control</h3>
        <p class="mt-0.5 text-xs text-slate-500">
          Cada solicitud lleva la categoría y la ruta que se esperaban. Nunca se le pasan a
          ningún agente: solo sirven para medir.
        </p>
        <dl class="mt-4 space-y-3">
          <div>
            <div class="flex items-baseline justify-between">
              <dt class="text-sm text-slate-700">Categoría acertada</dt>
              <dd class="text-sm font-semibold text-slate-900">
                {pct(m.precision.categoria)}
                <span class="font-normal text-slate-500"> ({m.precision.aciertosCategoria}/{m.precision.evaluadas})</span>
              </dd>
            </div>
            <div class="mt-1 h-2 w-full overflow-hidden rounded-full bg-slate-100">
              <div class="h-full rounded-full bg-marca"
                style={`width:${(m.precision.categoria ?? 0) * 100}%`}></div>
            </div>
          </div>
          <div>
            <div class="flex items-baseline justify-between">
              <dt class="text-sm text-slate-700">Ruta acertada</dt>
              <dd class="text-sm font-semibold text-slate-900">
                {pct(m.precision.ruta)}
                <span class="font-normal text-slate-500"> ({m.precision.aciertosRuta}/{m.precision.evaluadas})</span>
              </dd>
            </div>
            <div class="mt-1 h-2 w-full overflow-hidden rounded-full bg-slate-100">
              <div class="h-full rounded-full bg-marca"
                style={`width:${(m.precision.ruta ?? 0) * 100}%`}></div>
            </div>
          </div>
        </dl>
      </section>

      <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <h3 class="text-sm font-semibold text-slate-900">Estado de las solicitudes</h3>
        <dl class="mt-3 grid grid-cols-2 gap-3 text-sm">
          {[
            ['Resueltas por IA', m.porEstado.resuelto_ia],
            ['Pendientes de persona', m.porEstado.pendiente_humano],
            ['Respondidas por persona', m.porEstado.respondido_humano],
            ['Descartadas', m.porEstado.descartado],
          ].map(([etiqueta, n]) => (
            <div class="rounded-lg bg-slate-50 px-3 py-2">
              <dt class="text-xs text-slate-600">{etiqueta}</dt>
              <dd class="text-lg font-bold text-slate-900">{n}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>
  </div>

  <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="text-sm font-semibold text-slate-900">Qué hacen las personas con el borrador</h3>
    <p class="mt-0.5 max-w-2xl text-xs text-slate-500">
      Es la métrica que dice si la IA está redactando bien. Si casi todo se aprueba tal cual,
      el borrador sirve; si casi todo se reescribe, no. Además, lo que las personas editan o
      reescriben es justo lo que los redactores leen como ejemplo en la siguiente ejecución.
    </p>

    {m.borrador.total === 0 ? (
      <p class="mt-4 rounded-lg border border-dashed border-slate-300 px-3 py-6 text-center text-xs text-slate-500">
        Todavía nadie ha respondido desde la web. En cuanto alguien lo haga, aquí aparecerá el
        reparto y el bucle de aprendizaje empezará a alimentarse.
      </p>
    ) : (
      <div class="mt-4">
        <BarrasHorizontales titulo="Reparto de acciones" filas={ACCIONES_BORRADOR}
          unidad="respuestas" color="#0369a1" />
      </div>
    )}
  </section>
</Base>
