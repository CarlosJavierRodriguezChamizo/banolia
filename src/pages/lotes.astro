---
/**
 * Historial de ejecuciones del orquestador.
 * El botón «Lanzar lote» se añade en la fase 4, cuando exista sesión.
 */
import Base from '../layouts/Base.astro';
import Insignia from '../components/Insignia.astro';
import { lotes } from '../lib/datos.ts';
import { fechaLarga, fechaHora, hora } from '../lib/formato.ts';

export const prerender = false;

const totalSolicitudes = lotes.reduce((a, l) => a + l.totales.solicitudes, 0);
const totalIa = lotes.reduce((a, l) => a + l.totales.ia, 0);
const totalHumano = lotes.reduce((a, l) => a + l.totales.humano, 0);
const pct = (n: number) => (totalSolicitudes ? Math.round((n / totalSolicitudes) * 100) : 0);

const duracion = (a: string, b: string) =>
  `${Math.round((new Date(b).getTime() - new Date(a).getTime()) / 60000)} min`;
---

<Base titulo="Lotes" descripcion="Historial de ejecuciones del orquestador">
  <header class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight text-slate-900">Lotes publicados</h1>
    <p class="mt-1 text-sm text-slate-600">
      Cada lote es una ejecución de la rutina del orquestador, publicada en su propio commit
      para que el tablero se vaya llenando de forma progresiva.
    </p>
  </header>

  <section class="mb-6 grid grid-cols-2 gap-3 lg:grid-cols-4">
    {[
      { e: 'Lotes', v: String(lotes.length), d: 'ejecuciones publicadas' },
      { e: 'Solicitudes', v: String(totalSolicitudes), d: 'en total' },
      { e: 'Resueltas por IA', v: `${pct(totalIa)} %`, d: `${totalIa} solicitudes` },
      { e: 'A revisión humana', v: `${pct(totalHumano)} %`, d: `${totalHumano} solicitudes` },
    ].map((k) => (
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-xs font-medium uppercase tracking-wide text-slate-500">{k.e}</p>
        <p class="mt-1.5 text-2xl font-bold text-marca-oscuro">{k.v}</p>
        <p class="text-xs text-slate-500">{k.d}</p>
      </div>
    ))}
  </section>

  <div class="mb-6 rounded-xl border border-dashed border-slate-300 bg-white p-4">
    <p class="text-sm font-medium text-slate-700">Lanzar un lote manual</p>
    <p class="mt-1 text-sm text-slate-600">
      El botón para disparar la rutina bajo demanda se habilita en la fase 4, junto con el
      inicio de sesión. Requiere las variables <code class="rounded bg-slate-100 px-1 text-xs">ROUTINE_FIRE_URL</code>
      y <code class="rounded bg-slate-100 px-1 text-xs">ROUTINE_FIRE_TOKEN</code>.
    </p>
  </div>

  {lotes.length === 0 ? (
    <p class="rounded-xl border border-dashed border-slate-300 bg-white px-4 py-12 text-center text-sm text-slate-500">
      Todavía no hay lotes publicados.
    </p>
  ) : (
    <ul class="space-y-4">
      {lotes.map((l) => (
        <li class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="font-mono text-sm font-semibold text-slate-900">{l.id}</h2>
                <Insignia texto={l.origen === 'programado' ? 'Programado' : 'Manual'}
                  tono={l.origen === 'programado' ? 'marca' : 'neutro'} />
              </div>
              <p class="mt-1 text-sm text-slate-600">
                {fechaLarga(l.fecha)} · de {hora(l.iniciadoEn)} a {hora(l.finalizadoEn)}
                ({duracion(l.iniciadoEn, l.finalizadoEn)})
              </p>
            </div>

            <div class="flex flex-wrap gap-1.5">
              <Insignia texto={`${l.totales.solicitudes} solicitudes`} tono="neutro" />
              <Insignia texto={`${l.totales.ia} IA`} tono="ia" />
              <Insignia texto={`${l.totales.humano} humano`} tono="humano" />
              {l.totales.descartado > 0 && (
                <Insignia texto={`${l.totales.descartado} descartado`} tono="descartado" />
              )}
            </div>
          </div>

          {l.alertas.length > 0 && (
            <div class="mt-3 rounded-lg bg-amber-50 p-3 ring-1 ring-amber-200">
              <h3 class="text-xs font-semibold uppercase tracking-wide text-amber-800">
                {l.alertas.length === 1 ? 'Alerta registrada' : 'Alertas registradas'}
              </h3>
              <ul class="mt-1.5 list-disc space-y-1 pl-5 text-sm text-amber-900">
                {l.alertas.map((a) => <li>{a}</li>)}
              </ul>
            </div>
          )}

          <details class="mt-3">
            <summary class="cursor-pointer text-sm font-medium text-marca hover:underline">
              Ver las {l.solicitudes.length} solicitudes
            </summary>
            <ul class="mt-2 divide-y divide-slate-100 rounded-lg border border-slate-200">
              {l.solicitudes.map((s) => (
                <li>
                  <a href={`/solicitud/${s.id}`}
                    class="flex items-center gap-3 px-3 py-2 text-sm hover:bg-slate-50">
                    <span class="font-mono text-xs text-slate-500">{s.id}</span>
                    <span class="min-w-0 flex-1 truncate text-slate-800">{s.asunto}</span>
                    <span class="shrink-0 text-xs text-slate-400">{hora(s.recibidaEn)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </li>
      ))}
    </ul>
  )}
</Base>
