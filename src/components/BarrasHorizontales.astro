---
/**
 * Lista de barras horizontales para comparar magnitudes de una sola serie.
 *
 * La etiqueta y el valor van en HTML y la barra en SVG. El motivo es práctico: el
 * texto de un SVG no sabe truncarse, así que una etiqueta larga se corta en
 * pantallas estrechas. En HTML se trunca con puntos suspensivos a cualquier ancho
 * y el texto completo queda en el atributo `title` y en la tabla.
 *
 * Las barras van marcadas como decorativas: el número ya está en el texto, así que
 * un lector de pantalla no gana nada leyendo también el rectángulo.
 *
 * Al ser una sola serie no lleva leyenda: el título ya dice qué se mide.
 */
interface Fila { clave: string; etiqueta: string; n: number; }

interface Props {
  titulo: string;
  descripcion?: string;
  filas: Fila[];
  unidad?: string;
  color?: string;
}

const { titulo, descripcion, filas, unidad = 'solicitudes', color = 'var(--color-marca)' } = Astro.props;

const maximo = Math.max(1, ...filas.map((f) => f.n));
const ALTO_BARRA = 12;
const total = filas.reduce((a, f) => a + f.n, 0);

/** Un valor mayor que cero siempre deja ver algo de barra, aunque sea mínimo. */
const anchoPct = (n: number) => `${Math.max((n / maximo) * 100, n > 0 ? 1.5 : 0)}%`;
---

<figure class="min-w-0 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
  <figcaption>
    <h3 class="text-sm font-semibold text-slate-900">{titulo}</h3>
    {descripcion && <p class="mt-0.5 text-xs text-slate-500">{descripcion}</p>}
  </figcaption>

  {filas.length === 0 ? (
    <p class="mt-4 rounded-lg border border-dashed border-slate-300 px-3 py-8 text-center text-xs text-slate-400">
      Todavía no hay datos.
    </p>
  ) : (
    <>
      <ul class="mt-4 space-y-3">
        {filas.map((f) => (
          <li class="min-w-0" title={`${f.etiqueta}: ${f.n} ${unidad}`}>
            <div class="flex min-w-0 items-baseline justify-between gap-3">
              <span class="min-w-0 truncate text-[13px] font-medium text-slate-700">{f.etiqueta}</span>
              <span class="shrink-0 text-[13px] font-semibold text-slate-900">{f.n}</span>
            </div>
            <svg class="mt-1 block w-full" height={ALTO_BARRA} aria-hidden="true">
              <rect x="0" y="0" width="100%" height={ALTO_BARRA} rx="4" class="fill-slate-100" />
              {f.n > 0 && (
                <>
                  <rect x="0" y="0" width={anchoPct(f.n)} height={ALTO_BARRA} rx="4" fill={color} />
                  {/* Cuadra el extremo del origen: la barra nace de la línea base, no flota. */}
                  <rect x="0" y="0" width="4" height={ALTO_BARRA} fill={color} />
                </>
              )}
            </svg>
          </li>
        ))}
      </ul>

      <details class="mt-4">
        <summary class="cursor-pointer text-xs text-slate-500 hover:text-marca">Ver los datos en tabla</summary>
        <table class="mt-2 w-full table-fixed text-sm">
          <thead>
            <tr class="border-b border-slate-200 text-left text-xs uppercase tracking-wide text-slate-500">
              <th scope="col" class="py-1 font-medium">Concepto</th>
              <th scope="col" class="py-1 text-right font-medium">{unidad}</th>
              <th scope="col" class="py-1 text-right font-medium">%</th>
            </tr>
          </thead>
          <tbody>
            {filas.map((f) => (
              <tr class="border-b border-slate-100">
                <td class="break-words py-1 text-slate-700">{f.etiqueta}</td>
                <td class="py-1 text-right font-medium text-slate-900">{f.n}</td>
                <td class="py-1 text-right text-slate-600">
                  {total > 0 ? `${Math.round((f.n / total) * 100)} %` : '—'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </details>
    </>
  )}
</figure>
