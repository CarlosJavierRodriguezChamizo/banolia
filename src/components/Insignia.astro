---
/**
 * Insignia de color reutilizable para estados, prioridades, rutas y agentes.
 */
interface Props {
  texto: string;
  tono?: 'ia' | 'humano' | 'respondido' | 'descartado' | 'critica' | 'alta' | 'media' | 'baja' | 'neutro' | 'marca';
  titulo?: string;
}

const { texto, tono = 'neutro', titulo } = Astro.props;

const TONOS: Record<string, string> = {
  ia: 'bg-emerald-50 text-emerald-800 ring-emerald-600/20',
  humano: 'bg-amber-50 text-amber-900 ring-amber-600/25',
  respondido: 'bg-sky-50 text-sky-800 ring-sky-600/20',
  descartado: 'bg-slate-100 text-slate-600 ring-slate-500/20',
  critica: 'bg-red-50 text-red-800 ring-red-600/25',
  alta: 'bg-orange-50 text-orange-900 ring-orange-600/25',
  media: 'bg-sky-50 text-sky-800 ring-sky-600/20',
  baja: 'bg-slate-100 text-slate-600 ring-slate-500/20',
  neutro: 'bg-slate-100 text-slate-700 ring-slate-500/20',
  marca: 'bg-cyan-50 text-cyan-900 ring-cyan-600/20',
};
---
<span
  title={titulo}
  class:list={[
    'inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset whitespace-nowrap',
    TONOS[tono] ?? TONOS.neutro,
  ]}>{texto}</span>
