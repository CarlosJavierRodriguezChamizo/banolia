---
/**
 * Tarjeta de una solicitud en el tablero kanban.
 * Recibe la solicitud YA sin `_referencia` (ver datos.ts -> sinReferencia).
 */
import Insignia from './Insignia.astro';
import { ETIQUETA_CATEGORIA, ETIQUETA_PRIORIDAD, hora } from '../lib/formato.ts';
import type { Solicitud } from '../lib/esquemas.ts';

interface Props {
  solicitud: Omit<Solicitud, '_referencia'> & { loteId?: string };
}

const { solicitud: s } = Astro.props;
---
<article class="rounded-lg border border-slate-200 bg-white p-3 shadow-sm transition hover:border-marca hover:shadow-md">
  <a href={`/solicitud/${s.id}`} class="block rounded">
    <div class="flex items-start justify-between gap-2">
      <span class="font-mono text-xs text-slate-500">{s.id}</span>
      <Insignia texto={ETIQUETA_PRIORIDAD[s.clasificacion.prioridad]} tono={s.clasificacion.prioridad} />
    </div>

    <h3 class="mt-1.5 text-sm font-semibold leading-snug text-slate-900 line-clamp-2">{s.asunto}</h3>

    <p class="mt-1 truncate text-xs text-slate-600">
      {s.cliente.nombre} · {s.cliente.ciudad}
    </p>

    <div class="mt-2.5 flex flex-wrap items-center gap-1.5">
      <Insignia texto={ETIQUETA_CATEGORIA[s.clasificacion.categoria]} tono="marca" />
      {s.decision.criterios.map((c) => (
        <Insignia texto={c} tono="humano" titulo={`Criterio de escalado ${c}`} />
      ))}
      <span class="ml-auto text-xs text-slate-400">{hora(s.recibidaEn)}</span>
    </div>
  </a>
</article>
