---
/**
 * Formulario de filtros del tablero y de las secciones.
 *
 * Es un formulario GET normal: no lleva JavaScript. Los filtros se resuelven en
 * el servidor, se pueden compartir por enlace y funcionan sin scripts.
 */
import { ETIQUETA_CATEGORIA, ETIQUETA_PRIORIDAD, SECCIONES } from '../lib/formato.ts';
import { DIAS_POR_DEFECTO, type Filtros } from '../lib/filtros.ts';

interface Props {
  filtros: Filtros;
  accion: string;
  /** En las páginas de sección el selector de sección sobra. */
  ocultarSeccion?: boolean;
  total: number;
  mostradas: number;
}

const { filtros, accion, ocultarSeccion = false, total, mostradas } = Astro.props;

const OPCIONES_DIAS = [
  { valor: '1', texto: 'Hoy' },
  { valor: '7', texto: 'Últimos 7 días' },
  { valor: '30', texto: 'Últimos 30 días' },
  { valor: '0', texto: 'Todo el histórico' },
];

const diasSeleccionado = filtros.dias === null ? '0' : String(filtros.dias);
const hayFiltros =
  filtros.seccion !== null || filtros.prioridad !== null ||
  filtros.busqueda !== '' || filtros.dias !== DIAS_POR_DEFECTO;
---

<form
  method="get"
  action={accion}
  class="mb-6 rounded-xl border border-slate-200 bg-white p-4 shadow-sm"
  aria-label="Filtros de solicitudes">

  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <div class={ocultarSeccion ? 'hidden' : ''}>
      <label for="f-seccion" class="mb-1 block text-xs font-medium text-slate-600">Sección</label>
      <select id="f-seccion" name="seccion"
        class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm">
        <option value="">Todas</option>
        {SECCIONES.map((s) => (
          <option value={s} selected={filtros.seccion === s}>{ETIQUETA_CATEGORIA[s]}</option>
        ))}
        <option value="ruido" selected={filtros.seccion === 'ruido'}>Ruido</option>
      </select>
    </div>

    <div>
      <label for="f-prioridad" class="mb-1 block text-xs font-medium text-slate-600">Prioridad</label>
      <select id="f-prioridad" name="prioridad"
        class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm">
        <option value="">Todas</option>
        {(['critica', 'alta', 'media', 'baja'] as const).map((p) => (
          <option value={p} selected={filtros.prioridad === p}>{ETIQUETA_PRIORIDAD[p]}</option>
        ))}
      </select>
    </div>

    <div>
      <label for="f-dias" class="mb-1 block text-xs font-medium text-slate-600">Fecha</label>
      <select id="f-dias" name="dias"
        class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm">
        {OPCIONES_DIAS.map((o) => (
          <option value={o.valor} selected={diasSeleccionado === o.valor}>{o.texto}</option>
        ))}
      </select>
    </div>

    <div>
      <label for="f-q" class="mb-1 block text-xs font-medium text-slate-600">Búsqueda</label>
      <input id="f-q" name="q" type="search" value={filtros.busqueda}
        placeholder="Id, asunto, cliente o pedido"
        class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" />
    </div>
  </div>

  <div class="mt-3 flex flex-wrap items-center gap-3">
    <button type="submit"
      class="rounded-lg bg-marca px-4 py-2 text-sm font-medium text-white hover:bg-marca-oscuro">
      Filtrar
    </button>

    {hayFiltros && (
      <a href={accion} class="text-sm text-marca hover:underline">Quitar filtros</a>
    )}

    <p class="ml-auto text-sm text-slate-600" aria-live="polite">
      {mostradas === total
        ? <>Mostrando <strong class="text-slate-900">{total}</strong> solicitudes</>
        : <>Mostrando <strong class="text-slate-900">{mostradas}</strong> de {total} solicitudes</>}
    </p>
  </div>
</form>
